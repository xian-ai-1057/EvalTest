# 複製成 .env 後修改。真實環境變數會覆寫此檔的同名設定。
# .env 不會進版控（見 .gitignore）。

# ===== adapter / 連線 =====
# openai_chat：OpenAI 相容 chat（情境①②③）
# generic_json：單純自訂 JSON 服務（情境④⑥ 或既有服務，純設定即可接）
# vlm：VLM 圖片→文本 HTTP 服務（自訂 JSON base64，見下方 VLM_*）
# package：模型已封裝成 Python 套件、直接呼叫（非 HTTP，見 core/package_adapter_example.py）
# custom：自訂 adapter（見 core/custom_adapter_example.py）
ADAPTER=openai_chat
BASE_URL=http://127.0.0.1:8000          # 伺服器根；程式會自動接 /v1/chat/completions
API_KEY=
MODEL=test-model
REQUEST_TIMEOUT=60

# ===== 執行標籤（會寫進每一筆，用來區分卡別與精度）=====
RUN_LABEL=H100-FP8                       # 例：H100-FP8 / PRO6000-FP4

# ===== 請求內容 =====
INPUT_LEN=512
MAX_TOKENS=256
TEMPERATURE=0.0

# ===== 執行規模 =====
N_REQUESTS=20
CONCURRENCY_LEVELS=1,8,16,32,64,128      # 情境② 併發掃描

# ===== SLA 門檻（由 PM/業務填，情境② 用來判定達標）=====
SLA_TTFT_MS=1000
SLA_P95_MS=5000                          # 端到端 P95 上限（毫秒）

# ===== GPU 監控（背景輪詢本機 nvidia-smi；無 nvidia-smi 會自動略過）=====
GPU_MONITOR=false
GPU_SAMPLE_INTERVAL=0.5

# ===== 輸出 =====
OUTPUT_DIR=results
COUNT_UNIT=token                         # token | char

# ===== 通用 JSON adapter（ADAPTER=generic_json 時使用）=====
# 範例：BERT 分類 / STT 等自訂端點
GENERIC_URL=
GENERIC_REQUEST_TEMPLATE={"input": "{input}"}
GENERIC_RESPONSE_PATH=output             # 點路徑，如 data.output 或 choices.0.text
GENERIC_HEADERS={}

# ===== VLM 圖片→文本 =====
# ADAPTER=vlm（HTTP 自訂 JSON base64）時使用以下設定：
VLM_URL=http://127.0.0.1:8000/predict
VLM_PROMPT=請描述這張圖片的內容。
VLM_REQUEST_TEMPLATE={"image": "{image_b64}", "prompt": "{prompt}"}
VLM_RESPONSE_PATH=output                 # 從回應取輸出文本的點路徑
VLM_HEADERS={}
VLM_IMAGE_GLOB=data/images/*             # s_vlm.py 預設圖片來源（資料夾/glob）
VLM_IMAGE_DATA_URI=false                 # true 時 base64 前綴 data:<mime>;base64,
# ADAPTER=package（套件直呼）時：上面 VLM_PROMPT 仍會傳入；請編輯 core/package_adapter_example.py
